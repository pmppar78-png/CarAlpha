---
layout: layouts/base.njk
title: "Browse Cars by Make — All Vehicle Manufacturers | Car Alpha"
description: "Browse all vehicle makes and manufacturers. Find VIN decoder, specs, recalls, and ownership guides for every car brand from Acura to Volvo."
permalink: /cars-by-make/
priority: 0.8
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Browse Cars by Make",
  "description": "Complete directory of all vehicle manufacturers with VIN decoding, recall information, and ownership resources.",
  "url": "https://caralpha.org/cars-by-make/",
  "isPartOf": {
    "@type": "WebSite",
    "name": "Car Alpha",
    "url": "https://caralpha.org"
  }
}
</script>

{% breadcrumbs [{ label: "Home", url: "/" }, { label: "Cars by Make" }] %}

<section class="relative overflow-hidden">
  <div class="absolute inset-0 gradient-mesh"></div>
  <div class="relative max-w-5xl mx-auto px-4 pt-12 pb-20">

    <div class="glass-card metallic-border rounded-2xl overflow-hidden glow-cyan-sm carbon-panel mb-10">
      <div class="steel-header px-8 py-5">
        <h1 class="text-3xl md:text-4xl font-black text-white">Browse Cars by <span class="text-gradient">Make</span></h1>
        <p class="mt-2 text-sm text-silver-400">{{ makes | length }} vehicle manufacturers with full VIN decoding and recall data</p>
      </div>
      <div class="px-8 py-6">
        <p class="text-silver-400 leading-relaxed mb-6">Explore every vehicle manufacturer in our database. Each make page provides VIN decoding, recall checks, model listings, and state-specific ownership guides powered by official NHTSA data.</p>
      </div>
    </div>

    {# Group by type #}
    {% set makeTypes = { "mainstream": "Mainstream Brands", "luxury": "Luxury Brands", "ev": "Electric Vehicle Brands", "motorcycle": "Motorcycle Brands", "discontinued": "Discontinued Brands" } %}

    {% for typeKey, typeLabel in makeTypes %}
    {% set typeMakes = [] %}
    {% for make in makes %}{% if make.type == typeKey %}{% set typeMakes = (typeMakes.push(make), typeMakes) %}{% endif %}{% endfor %}
    {% if typeMakes | length > 0 %}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel mb-6">
      <div class="steel-header px-8 py-4">
        <h2 class="text-xl font-bold text-white">{{ typeLabel }}</h2>
        <p class="text-xs text-silver-500 mt-1">{{ typeMakes | length }} manufacturers</p>
      </div>
      <div class="px-8 py-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {% for make in typeMakes %}
          <a href="/makes/{{ make.slug }}/" class="glass-card rounded-xl p-4 card-hover group">
            <h3 class="font-bold text-white group-hover:text-volt-400 transition-colors">{{ make.name }}</h3>
            <p class="text-xs text-silver-500 mt-1">{{ make.country }} &middot; Est. {{ make.founded }}</p>
            {% if make.popularModels and make.popularModels.length > 0 %}
            <p class="text-xs text-silver-500/70 mt-2">Popular: {{ make.popularModels | join(", ") | truncate(60) }}</p>
            {% endif %}
          </a>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
    {% endfor %}

    {# Cross-links #}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel">
      <div class="steel-header px-8 py-4">
        <h2 class="text-xl font-bold text-white">More Ways to Browse</h2>
      </div>
      <div class="px-8 py-6 grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        <a href="/cars-by-model/" class="glass-card rounded-xl p-4 card-hover group">
          <h3 class="font-bold text-white group-hover:text-volt-400 transition-colors">Cars by Model</h3>
          <p class="text-xs text-silver-500 mt-1">Browse all {{ models | length }} models</p>
        </a>
        <a href="/popular-cars/" class="glass-card rounded-xl p-4 card-hover group">
          <h3 class="font-bold text-white group-hover:text-volt-400 transition-colors">Popular Cars</h3>
          <p class="text-xs text-silver-500 mt-1">Most searched vehicles</p>
        </a>
        <a href="/vin-checker/" class="glass-card rounded-xl p-4 card-hover group">
          <h3 class="font-bold text-white group-hover:text-volt-400 transition-colors">VIN Checker</h3>
          <p class="text-xs text-silver-500 mt-1">Decode any VIN instantly</p>
        </a>
        <a href="/states/" class="glass-card rounded-xl p-4 card-hover group">
          <h3 class="font-bold text-white group-hover:text-volt-400 transition-colors">Browse by State</h3>
          <p class="text-xs text-silver-500 mt-1">State ownership guides</p>
        </a>
        <a href="/recent-lookups/" class="glass-card rounded-xl p-4 card-hover group">
          <h3 class="font-bold text-white group-hover:text-volt-400 transition-colors">Recent Lookups</h3>
          <p class="text-xs text-silver-500 mt-1">Recently checked vehicles</p>
        </a>
        <a href="/sitemap-html/" class="glass-card rounded-xl p-4 card-hover group">
          <h3 class="font-bold text-white group-hover:text-volt-400 transition-colors">Full Site Directory</h3>
          <p class="text-xs text-silver-500 mt-1">Complete page index</p>
        </a>
      </div>
    </div>

  </div>
</section>
