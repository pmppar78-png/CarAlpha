---
layout: layouts/base.njk
title: "Site Directory — Complete Page Index | Car Alpha"
description: "Complete HTML sitemap and page directory for Car Alpha. Browse all vehicle makes, models, year pages, state guides, tools, and resources."
permalink: /sitemap-html/
priority: 0.5
---

{% breadcrumbs [{ label: "Home", url: "/" }, { label: "Site Directory" }] %}

<section class="relative overflow-hidden">
  <div class="absolute inset-0 gradient-mesh"></div>
  <div class="relative max-w-5xl mx-auto px-4 pt-12 pb-20">

    <div class="glass-card metallic-border rounded-2xl overflow-hidden glow-cyan-sm carbon-panel mb-10">
      <div class="steel-header px-8 py-5">
        <h1 class="text-3xl md:text-4xl font-black text-white">Site <span class="text-gradient">Directory</span></h1>
        <p class="mt-2 text-sm text-silver-400">Complete index of all pages on Car Alpha</p>
      </div>
      <div class="px-8 py-6">
        <p class="text-silver-400 leading-relaxed">This page serves as a complete directory of Car Alpha. Use the sections below to navigate to any page on the site, from VIN tools to state-specific ownership guides.</p>
        <p class="text-xs text-silver-500 mt-3">Last updated: <time datetime="2026-03-26">March 26, 2026</time></p>
      </div>
    </div>

    {# Main Pages #}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel mb-6">
      <div class="steel-header px-8 py-4">
        <h2 class="text-xl font-bold text-white">Main Pages</h2>
      </div>
      <div class="px-8 py-5">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
          <a href="/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Home</a>
          <a href="/vin-decoder/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">VIN Decoder</a>
          <a href="/vin-checker/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">VIN Checker</a>
          <a href="/recall-checker/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Recall Checker</a>
          <a href="/free-vin-check/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Free VIN Check</a>
          <a href="/vin-number-lookup/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">VIN Number Lookup</a>
          <a href="/compare/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Compare Vehicles</a>
          <a href="/popular-cars/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Popular Cars</a>
          <a href="/recent-lookups/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Recent Lookups</a>
          <a href="/cars-by-make/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Cars by Make</a>
          <a href="/cars-by-model/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Cars by Model</a>
          <a href="/makes/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">All Makes</a>
          <a href="/states/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">All States</a>
          <a href="/guides/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Guides</a>
          <a href="/learn/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Learn</a>
          <a href="/blog/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Blog</a>
          <a href="/recalls/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Recalls</a>
          <a href="/glossary/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Glossary</a>
          <a href="/about/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">About</a>
          <a href="/contact/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Contact</a>
        </div>
      </div>
    </div>

    {# All Vehicle Makes #}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel mb-6">
      <div class="steel-header px-8 py-4">
        <h2 class="text-xl font-bold text-white">All Vehicle Makes ({{ makes | length }})</h2>
      </div>
      <div class="px-8 py-5">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">
          {% for make in makes %}
          <a href="/makes/{{ make.slug }}/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">{{ make.name }}</a>
          {% endfor %}
        </div>
      </div>
    </div>

    {# All Models by Make #}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel mb-6">
      <div class="steel-header px-8 py-4">
        <h2 class="text-xl font-bold text-white">All Vehicle Models ({{ models | length }})</h2>
      </div>
      <div class="px-8 py-5">
        {% for make in makes %}
        {% set makeModels = [] %}
        {% for model in models %}{% if model.makeSlug == make.slug %}{% set makeModels = (makeModels.push(model), makeModels) %}{% endif %}{% endfor %}
        {% if makeModels | length > 0 %}
        <div class="mb-5 last:mb-0">
          <h3 class="text-sm font-bold text-silver-300 mb-2"><a href="/makes/{{ make.slug }}/" class="hover:text-volt-400 transition-colors">{{ make.name }}</a></h3>
          <div class="flex flex-wrap gap-1.5">
            {% for model in makeModels %}
            <a href="/makes/{{ model.makeSlug }}/{{ model.slug }}/" class="px-2.5 py-1 rounded bg-white/[0.03] border border-white/[0.05] text-xs text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">{{ model.name }}</a>
            {% endfor %}
          </div>
        </div>
        {% endif %}
        {% endfor %}
      </div>
    </div>

    {# All States #}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel mb-6">
      <div class="steel-header px-8 py-4">
        <h2 class="text-xl font-bold text-white">All States ({{ states | length }})</h2>
      </div>
      <div class="px-8 py-5">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
          {% for state in states %}
          <div>
            <a href="/states/{{ state.slug }}/" class="text-sm text-silver-400 hover:text-volt-400 transition-colors font-medium">{{ state.name }}</a>
            <div class="flex flex-wrap gap-1 mt-1">
              <a href="/states/{{ state.slug }}/insurance/" class="text-[10px] text-silver-500 hover:text-volt-400">Insurance</a>
              <a href="/states/{{ state.slug }}/lemon-law/" class="text-[10px] text-silver-500 hover:text-volt-400">Lemon Law</a>
              <a href="/states/{{ state.slug }}/registration/" class="text-[10px] text-silver-500 hover:text-volt-400">Registration</a>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>

    {# Model Years - sample pages (showing representative entries) #}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel mb-6">
      <div class="steel-header px-8 py-4">
        <h2 class="text-xl font-bold text-white">Model Year Pages ({{ modelYears | length }} pages)</h2>
        <p class="text-xs text-silver-500 mt-1">Showing representative entries. Full listing in <a href="/sitemap.xml" class="text-volt-400">XML sitemap</a>.</p>
      </div>
      <div class="px-8 py-5">
        {% for make in makes | limit(20) %}
        {% set makeModelYears = [] %}
        {% for my in modelYears %}{% if my.makeSlug == make.slug %}{% set makeModelYears = (makeModelYears.push(my), makeModelYears) %}{% endif %}{% endfor %}
        {% if makeModelYears | length > 0 %}
        <div class="mb-4 last:mb-0">
          <h3 class="text-sm font-bold text-silver-300 mb-2"><a href="/makes/{{ make.slug }}/" class="hover:text-volt-400 transition-colors">{{ make.name }}</a></h3>
          <div class="flex flex-wrap gap-1.5">
            {% for my in makeModelYears | limit(12) %}
            <a href="/makes/{{ my.makeSlug }}/{{ my.slug }}/{{ my.year }}/" class="px-2.5 py-1 rounded bg-white/[0.03] border border-white/[0.05] text-xs text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">{{ my.year }} {{ my.name }}</a>
            {% endfor %}
            {% if makeModelYears | length > 12 %}
            <span class="px-2.5 py-1 text-xs text-silver-500">+{{ makeModelYears | length - 12 }} more</span>
            {% endif %}
          </div>
        </div>
        {% endif %}
        {% endfor %}
      </div>
    </div>

    {# Dynamic State Pages - representative sample #}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel mb-6">
      <div class="steel-header px-8 py-4">
        <h2 class="text-xl font-bold text-white">Vehicle Ownership by State ({{ (makes | length) * (states | length) + (models | length) * (states | length) }}+ pages)</h2>
        <p class="text-xs text-silver-500 mt-1">Make/state and model/state guides rendered dynamically. Showing top combinations.</p>
      </div>
      <div class="px-8 py-5">
        {% set topMakes = ["toyota", "honda", "ford", "chevrolet", "bmw", "nissan", "hyundai", "tesla", "kia", "subaru"] %}
        {% set topStatesList = ["california", "texas", "florida", "new-york", "illinois", "ohio", "pennsylvania", "georgia", "michigan", "washington"] %}
        {% for makeSlug in topMakes %}
        {% for make in makes %}{% if make.slug == makeSlug %}
        <div class="mb-4 last:mb-0">
          <h3 class="text-sm font-bold text-silver-300 mb-2">{{ make.name }}</h3>
          <div class="flex flex-wrap gap-1.5">
            {% for stateSlug in topStatesList %}
            {% for state in states %}{% if state.slug == stateSlug %}
            <a href="/makes/{{ makeSlug }}/in/{{ stateSlug }}/" class="px-2.5 py-1 rounded bg-white/[0.03] border border-white/[0.05] text-xs text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">{{ make.name }} in {{ state.name }}</a>
            {% endif %}{% endfor %}
            {% endfor %}
          </div>
        </div>
        {% endif %}{% endfor %}
        {% endfor %}
      </div>
    </div>

    {# Guides #}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel mb-6">
      <div class="steel-header px-8 py-4">
        <h2 class="text-xl font-bold text-white">Guides & Resources</h2>
      </div>
      <div class="px-8 py-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {% for guide in collections.guides %}
          <a href="{{ guide.url }}" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">{{ guide.data.title }}</a>
          {% endfor %}
        </div>
      </div>
    </div>

    {# Learn #}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel mb-6">
      <div class="steel-header px-8 py-4">
        <h2 class="text-xl font-bold text-white">Learn Center</h2>
      </div>
      <div class="px-8 py-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {% for item in collections.learn %}
          <a href="{{ item.url }}" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">{{ item.data.title }}</a>
          {% endfor %}
        </div>
      </div>
    </div>

    {# Blog #}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel mb-6">
      <div class="steel-header px-8 py-4">
        <h2 class="text-xl font-bold text-white">Blog Posts</h2>
      </div>
      <div class="px-8 py-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {% for post in collections.blog %}
          <a href="{{ post.url }}" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">{{ post.data.title }}</a>
          {% endfor %}
        </div>
      </div>
    </div>

    {# Legal #}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel">
      <div class="steel-header px-8 py-4">
        <h2 class="text-xl font-bold text-white">Legal & Company</h2>
      </div>
      <div class="px-8 py-5">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          <a href="/about/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">About</a>
          <a href="/contact/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Contact</a>
          <a href="/editorial-standards/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Editorial Standards</a>
          <a href="/data-transparency/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Data Transparency</a>
          <a href="/methodology/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Methodology</a>
          <a href="/industry-resources/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Industry Resources</a>
          <a href="/privacy/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Privacy Policy</a>
          <a href="/terms/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Terms of Service</a>
          <a href="/disclaimer/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Disclaimer</a>
          <a href="/affiliate-disclosure/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Affiliate Disclosure</a>
          <a href="/cookie-policy/" class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/[0.05] text-sm text-silver-400 hover:text-volt-400 hover:border-volt-500/25 transition-all">Cookie Policy</a>
        </div>
      </div>
    </div>

  </div>
</section>
