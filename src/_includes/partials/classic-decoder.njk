<div class="vin-card glass-card rounded-2xl p-5 sm:p-6 md:p-8 glow-cyan max-w-2xl mx-auto carbon-panel text-left" role="search" aria-label="Classic VIN decoder">
  <div class="flex items-baseline justify-between gap-3 mb-3">
    <label for="vinInput" class="text-sm md:text-base font-bold text-white tracking-wide">Classic VIN / serial number</label>
    <span id="vinCount" class="text-xs font-mono text-silver-500" aria-live="polite">0</span>
  </div>
  <div class="flex flex-col sm:flex-row gap-3">
    <input id="vinInput" name="vin" type="text" maxlength="17" placeholder="e.g. {{ example or '124377N100001' }}" autocomplete="off" autocapitalize="characters" autocorrect="off" spellcheck="false" enterkeyhint="go"
      class="flex-1 w-full min-h-[56px] px-4 sm:px-5 py-4 rounded-xl input-premium text-white placeholder-silver-500/70 text-lg sm:text-base font-mono tracking-[0.12em] uppercase" />
    <button id="runBtn" type="button" class="w-full sm:w-auto min-h-[56px] px-8 py-4 rounded-xl btn-primary text-white font-bold text-base whitespace-nowrap">Decode</button>
  </div>
  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-silver-500">
    <span>Runs in your browser. Nothing is stored.</span>
    <button type="button" id="classicSample" data-sample="{{ example or '124377N100001' }}" class="text-volt-400 hover:text-volt-300 underline underline-offset-2">Try a sample</button>
    <a href="/" class="text-volt-400 hover:text-volt-300 underline underline-offset-2">Have a 17-character VIN?</a>
  </div>
</div>
<div class="max-w-3xl mx-auto mt-6 space-y-5 text-left">
  <div class="hidden" id="errorBox"><div class="p-5 rounded-2xl border border-red-500/30 bg-red-500/10 text-red-300" id="errorText"></div></div>
  <div class="hidden" id="vehicleCard"></div>
</div>
<script>
(function () {
  var input = document.getElementById('vinInput'), count = document.getElementById('vinCount'), run = document.getElementById('runBtn'), s = document.getElementById('classicSample');
  function upd() { var c = input.value.toUpperCase().replace(/[^A-Z0-9]/g, ''); if (c !== input.value) input.value = c; count.textContent = c.length + ' chars'; }
  input.addEventListener('input', upd);
  s.addEventListener('click', function () { input.value = s.getAttribute('data-sample'); upd(); run.click(); });
  run.addEventListener('click', function () {
    var v = input.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
    var eb = document.getElementById('errorBox');
    if (v.length === 17) { location.href = '/?vin=' + encodeURIComponent(v) + '&go=1'; return; }
    eb.classList.remove('hidden'); document.getElementById('errorText').textContent = v.length ? 'Classic serial numbers are usually 11 to 13 characters. Please check the number on the VIN plate.' : 'Please enter the serial number from the VIN plate.';
  });
  upd();
})();
</script>
