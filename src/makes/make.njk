---
layout: layouts/base.njk
pagination:
  data: makes
  size: 1
  alias: make
permalink: "/makes/{{ make.slug }}/"
eleventyComputed:
  title: "{{ make.name }} VIN Decoder & Recall Check (2026) — Free | Car Alpha"
  description: "Free {{ make.name }} VIN decoder and recall checker. Decode any {{ make.name }} VIN instantly for full specs, open safety recalls, and ownership guidance. Official NHTSA data, no account required."
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Brand",
  "name": "{{ make.name }}",
  "description": "{{ make.description | truncate(160) }}",
  "url": "https://caralpha.org/makes/{{ make.slug }}/"
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I decode a {{ make.name }} VIN?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Enter your 17-character {{ make.name }} VIN into Car Alpha's free VIN decoder to instantly get full specs, recall history, manufacturing details, and ownership guidance using official NHTSA VPIC data."
      }
    },
    {
      "@type": "Question",
      "name": "How do I check {{ make.name }} recalls?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Use Car Alpha's free recall checker or enter your {{ make.name }} VIN to search the official NHTSA recall database. All recall repairs are performed free of charge at authorized {{ make.name }} dealerships regardless of vehicle age or mileage."
      }
    },
    {
      "@type": "Question",
      "name": "What {{ make.name }} models are available?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ make.name }} currently produces a range of vehicles including {{ make.popularModels | join(', ') | replace('-', ' ') | title }}. Browse all {{ make.name }} models on Car Alpha for VIN decoding, specs, and recall information."
      }
    },
    {
      "@type": "Question",
      "name": "Is {{ make.name }} VIN decoding free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Car Alpha provides 100% free {{ make.name }} VIN decoding using official NHTSA data. No account or payment required. Get instant results including make, model, year, engine, body type, trim, recalls, and more."
      }
    }
  ]
}
</script>

{% breadcrumbs [{ label: "Home", url: "/" }, { label: "Makes", url: "/makes/" }, { label: make.name }] %}

<section class="relative overflow-hidden">
  <div class="absolute inset-0 gradient-mesh"></div>
  <div class="relative max-w-5xl mx-auto px-4 pt-12 pb-20">

    {# Make Header #}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden glow-cyan-sm carbon-panel mb-10">
      <div class="steel-header px-8 py-5">
        <div class="flex items-center justify-between flex-wrap gap-4">
          <div>
            <h1 class="text-3xl md:text-4xl font-black text-white">{{ make.name }}</h1>
            <div class="flex items-center gap-4 mt-2 text-sm text-silver-400">
              <span>{{ make.country }}</span>
              <span>&middot;</span>
              <span>Founded {{ make.founded }}</span>
              <span>&middot;</span>
              {% if make.active %}
                <span class="text-emerald-400 font-medium">Active</span>
              {% else %}
                <span class="text-amber-400 font-medium">Discontinued</span>
              {% endif %}
            </div>
          </div>
          <span class="px-4 py-2 rounded-xl bg-volt-600/10 border border-volt-500/20 text-volt-400 text-xs font-bold uppercase tracking-wider">{{ make.type }}</span>
        </div>
      </div>
      <div class="px-8 py-6">
        <p class="text-silver-400 leading-relaxed">{{ make.description }}</p>
      </div>
    </div>

    {# Popular Models #}
    {% if make.popularModels and make.popularModels.length %}
    <div class="mb-12">
      <h2 class="text-xl font-black text-white mb-6">Popular {{ make.name }} Models</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {% for modelSlug in make.popularModels %}
          {% set modelData = false %}
          {% for m in models %}
            {% if m.makeSlug == make.slug and m.slug == modelSlug %}
              {% set modelData = m %}
            {% endif %}
          {% endfor %}
          {% if modelData %}
            <a href="/makes/{{ make.slug }}/{{ modelSlug }}/" class="glass-card metallic-border rounded-xl p-4 card-hover carbon-panel group text-center">
              <div class="font-bold text-white group-hover:text-volt-400 transition-colors text-sm">{{ modelData.name }}</div>
              <div class="text-[10px] text-silver-500 mt-1">{{ modelData.bodyType }}</div>
            </a>
          {% else %}
            <div class="glass-card rounded-xl p-4 carbon-panel text-center border border-white/[0.04]">
              <div class="font-bold text-silver-400 text-sm capitalize">{{ modelSlug | replace("-", " ") }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {# VIN Decoder for this make #}
    <div class="mb-12">
      <h2 class="text-xl font-black text-white mb-6">Decode a {{ make.name }} VIN</h2>
      <div class="vin-card glass-card rounded-2xl p-6 glow-cyan carbon-panel">
        <label class="block text-sm font-bold text-silver-300 mb-3 tracking-wide uppercase">Enter your {{ make.name }} VIN</label>
        <div class="flex flex-col sm:flex-row gap-3">
          <input id="vinInput" maxlength="17" placeholder="Enter 17-character VIN" class="flex-1 px-5 py-4 rounded-xl input-premium text-white placeholder-silver-500 text-base font-mono tracking-wider" />
          <button id="runBtn" class="px-8 py-4 rounded-xl btn-primary text-white font-bold text-base whitespace-nowrap tracking-wide">Decode VIN</button>
        </div>
      </div>
      <section class="mt-6 space-y-5">
        <div class="hidden" id="loading"><div class="glass-card rounded-2xl p-6 border-glow text-center carbon-panel"><div class="inline-flex items-center gap-3 text-silver-300"><svg class="animate-spin w-5 h-5 text-volt-400" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>Decoding...</div></div></div>
        <div class="hidden" id="errorBox"><div class="p-5 rounded-2xl border border-red-500/30 bg-red-500/10 text-red-300" id="errorText"></div></div>
        <div class="hidden" id="vehicleCard"></div>
        <div class="hidden" id="recallCard"></div>
      </section>
    </div>

    {# Recall Info #}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel mb-10">
      <div class="steel-header px-6 py-4">
        <h2 class="font-bold text-white text-lg">{{ make.name }} Recall Information</h2>
      </div>
      <div class="px-6 py-5 text-sm text-silver-400 leading-relaxed">
        <p>{{ make.name }} vehicles, like all manufacturers, are subject to safety recalls issued by the National Highway Traffic Safety Administration (NHTSA). Recalls address safety-related defects or non-compliance with federal safety standards. All recall repairs are performed free of charge at authorized {{ make.name }} dealerships.</p>
        <p class="mt-3">To check if a specific {{ make.name }} vehicle has open recalls, enter the VIN above or use our <a href="/recall-checker/" class="text-volt-400 hover:underline">Recall Checker</a>.</p>
      </div>
    </div>

    {# ── {{ make.name }} by State (cross-link to make+state pages) ── #}
    <div class="mb-12">
      <h2 class="text-xl font-black text-white mb-6">{{ make.name }} by State</h2>
      <p class="text-silver-400 text-sm mb-5">Explore {{ make.name }} ownership guides, insurance requirements, and dealer information for each state.</p>
