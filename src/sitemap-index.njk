---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap>
    <loc>https://caralpha.org/sitemap-core.xml</loc>
    <lastmod>{{ buildInfo.lastmod }}</lastmod>
  </sitemap>
{%- set myPages = (modelYears | length / 45000) | round(0, "ceil") %}
{%- for i in range(0, myPages) %}
  <sitemap>
    <loc>https://caralpha.org/sitemap-modelyears-{{ i }}.xml</loc>
    <lastmod>{{ buildInfo.lastmod }}</lastmod>
  </sitemap>
{%- endfor %}
{%- set dynPages = (sitemapDynamic | length / 45000) | round(0, "ceil") %}
{%- for i in range(0, dynPages) %}
  <sitemap>
    <loc>https://caralpha.org/sitemap-dynamic-{{ i }}.xml</loc>
    <lastmod>{{ buildInfo.lastmod }}</lastmod>
  </sitemap>
{%- endfor %}
</sitemapindex>
