{%- for guide in collections.guides %}
  <url>
    <loc>https://caralpha.org{{ guide.url }}</loc>
    <lastmod>{{ guide.date | dateFormat("yyyy-LL-dd") }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
{%- endfor %}
{%- for post in collections.blog %}
  <url>
    <loc>https://caralpha.org{{ post.url }}</loc>
    <lastmod>{{ post.date | dateFormat("yyyy-LL-dd") }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
{%- endfor %}
{%- for item in collections.learn %}
  <url>
    <loc>https://caralpha.org{{ item.url }}</loc>
    <lastmod>{{ item.date | dateFormat("yyyy-LL-dd") }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
{%- endfor %}
