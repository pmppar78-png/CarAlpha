<script>
document.getElementById('vinCheckerBtn').addEventListener('click', function(e) {
  var vin = document.getElementById('vinCheckerInput').value.trim();
  if (vin) {
    e.preventDefault();
    window.location.href = '/vin-decoder/?vin=' + encodeURIComponent(vin);
  }
});
</script>
