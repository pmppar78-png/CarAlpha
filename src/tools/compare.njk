              <svg class="w-6 h-6 text-volt-400 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.1-5.1a1.5 1.5 0 010-2.12l.87-.87a1.5 1.5 0 012.12 0L12 9.75l2.69-2.69a1.5 1.5 0 012.12 0l.87.87a1.5 1.5 0 010 2.12l-5.1 5.1a1.5 1.5 0 01-2.12 0z"/></svg>
