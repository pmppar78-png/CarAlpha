---
layout: layouts/base.njk
pagination:
  data: modelYears
  size: 1
  alias: entry
permalink: "/makes/{{ entry.makeSlug }}/{{ entry.slug }}/{{ entry.year }}/"
eleventyComputed:
  title: "{{ entry.year }} {{ entry.makeName }} {{ entry.name }} — VIN Decoder, Specs & Recalls"
  description: "Free VIN decoder and recall check for the {{ entry.year }} {{ entry.makeName }} {{ entry.name }}. Decode any {{ entry.year }} {{ entry.name }} VIN for full specs, safety recalls, and ownership resources."
---
{% set copy = entry | yearCopy %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "{{ entry.year }} {{ entry.makeName }} {{ entry.name }} — Specs, Recalls & Information",
  "description": "Free VIN decoder and recall check for the {{ entry.year }} {{ entry.makeName }} {{ entry.name }}. Decode any {{ entry.year }} {{ entry.name }} VIN for full specs, safety recalls, and ownership resources.",
  "url": "https://caralpha.org/makes/{{ entry.makeSlug }}/{{ entry.slug }}/{{ entry.year }}/",
  "publisher": {
    "@type": "Organization",
    "name": "Car Alpha",
    "url": "https://caralpha.org",
    "logo": {
      "@type": "ImageObject",
      "url": "https://caralpha.org/assets/images/logo.png"
    }
  }
}
</script>
<script type="application/ld+json">
{{ copy.faqSchema | jsonStringify | safe }}
</script>

{% breadcrumbs [{ label: "Home", url: "/" }, { label: "Makes", url: "/makes/" }, { label: entry.makeName, url: "/makes/" + entry.makeSlug + "/" }, { label: entry.name, url: "/makes/" + entry.makeSlug + "/" + entry.slug + "/" }, { label: entry.year | string }] %}

<section class="relative overflow-hidden">
  <div class="absolute inset-0 gradient-mesh"></div>
  <div class="relative max-w-5xl mx-auto px-4 pt-12 pb-20">

    {# Year Model Header #}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden glow-cyan-sm carbon-panel mb-10">
      <div class="steel-header px-8 py-5">
        <h1 class="text-3xl md:text-4xl font-black text-white"><span class="text-gradient">{{ entry.year }}</span> {{ entry.makeName }} {{ entry.name }}</h1>
        <div class="flex items-center gap-4 mt-2 text-sm text-silver-400">
          <span>{{ entry.bodyType }}</span>
          <span>&middot;</span>
          <span>Model Year {{ entry.year }}</span>
        </div>
      </div>
      <div class="px-8 py-6" data-vehicle-copy>
        {% for paragraph in copy.paragraphs %}
        <p class="text-silver-400 leading-relaxed {% if not loop.first %}mt-4{% endif %}">{{ paragraph }}</p>
        {% endfor %}
      </div>
    </div>

    {# Year Context Info #}
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
      <div class="glass-card metallic-border rounded-xl p-5 text-center carbon-panel">
        <div class="text-2xl font-black text-volt-400">{{ copy.ctx.ordinalWord }} of {{ copy.ctx.total }}</div>
        <div class="text-xs text-silver-400 mt-1">Catalog year</div>
      </div>
      <div class="glass-card metallic-border rounded-xl p-5 text-center carbon-panel">
        <div class="text-2xl font-black text-volt-400">{{ entry.bodyType }}</div>
        <div class="text-xs text-silver-400 mt-1">Body style on file</div>
      </div>
      <div class="glass-card metallic-border rounded-xl p-5 text-center carbon-panel">
        <div class="text-2xl font-black text-volt-400">{% if copy.ctx.vinCode %}{{ copy.ctx.vinCode }}{% else %}—{% endif %}</div>
        <div class="text-xs text-silver-400 mt-1">VIN year code (position 10)</div>
      </div>
      <div class="glass-card metallic-border rounded-xl p-5 text-center carbon-panel">
        <div class="text-2xl font-black text-volt-400">{{ copy.ctx.age }}</div>
        <div class="text-xs text-silver-400 mt-1">Years old in 2026</div>
      </div>
    </div>

    {% set facts = entry | factSentences %}
    {% if facts.length %}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel mb-10">
      <div class="steel-header px-6 py-4">
        <h2 class="font-bold text-white text-lg">Recorded figures, October 23, 2026</h2>
      </div>
      <div class="px-6 py-5 text-sm text-silver-400 leading-relaxed space-y-3">
        {% for line in facts %}
        <p>{{ line }}</p>
        {% endfor %}
        <p class="text-xs text-silver-500"><a href="https://www.fueleconomy.gov/" class="text-volt-400 hover:underline" rel="noopener">fueleconomy.gov</a> · <a href="https://api.nhtsa.gov/" class="text-volt-400 hover:underline" rel="noopener">api.nhtsa.gov</a></p>
      </div>
    </div>
    {% endif %}

    {# VIN Decoder #}
    <div class="mb-12">
      <h2 class="text-xl font-black text-white mb-6">Decode {{ entry.year | aan }} {{ entry.year }} {{ entry.makeName }} {{ entry.name }} VIN</h2>
      <div class="vin-card glass-card rounded-2xl p-6 glow-cyan carbon-panel">
        <label class="block text-sm font-bold text-silver-300 mb-3 tracking-wide uppercase">Enter VIN</label>
        <div class="flex flex-col sm:flex-row gap-3">
          <input id="vinInput" maxlength="17" placeholder="Enter 17-character VIN" class="flex-1 px-5 py-4 rounded-xl input-premium text-white placeholder-silver-500 text-base font-mono tracking-wider" />
          <button id="runBtn" class="px-8 py-4 rounded-xl btn-primary text-white font-bold text-base whitespace-nowrap">Decode</button>
        </div>
      </div>
      <section class="mt-6 space-y-5">
        <div class="hidden" id="loading"><div class="glass-card rounded-2xl p-6 border-glow text-center carbon-panel"><div class="inline-flex items-center gap-3 text-silver-300"><svg class="animate-spin w-5 h-5 text-volt-400" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>Decoding...</div></div></div>
        <div class="hidden" id="errorBox"><div class="p-5 rounded-2xl border border-red-500/30 bg-red-500/10 text-red-300" id="errorText"></div></div>
        <div class="hidden" id="vehicleCard"></div>
        <div class="hidden" id="recallCard"></div>
      </section>
    </div>

    {# Shared guides — the generic advice lives here, not copied onto every year #}
    <div class="mb-10">
      <h2 class="text-xl font-black text-white mb-4">Next steps for {{ entry.year | aan }} {{ entry.year }} {{ entry.name }}</h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-3">
        <a href="/recall-checker/" class="glass-card metallic-border rounded-xl p-4 card-hover carbon-panel group">
          <div class="font-bold text-white text-sm group-hover:text-volt-400 transition-colors">Check recalls by VIN</div>
          <div class="text-[10px] text-silver-500 mt-1">NHTSA campaign data for this {{ entry.year }} {{ entry.name }}, then a free dealer remedy</div>
        </a>
        <a href="/guides/how-to-check-car-before-buying/" class="glass-card metallic-border rounded-xl p-4 card-hover carbon-panel group">
          <div class="font-bold text-white text-sm group-hover:text-volt-400 transition-colors">Pre-purchase checklist</div>
          <div class="text-[10px] text-silver-500 mt-1">The inspection steps, kept in one guide instead of repeated on every year</div>
        </a>
        <a href="/guides/lemon-law/" class="glass-card metallic-border rounded-xl p-4 card-hover carbon-panel group">
          <div class="font-bold text-white text-sm group-hover:text-volt-400 transition-colors">Lemon law, if repairs repeat</div>
          <div class="text-[10px] text-silver-500 mt-1">Federal warranty law, plus the state statute</div>
        </a>
        <a href="/guides/warranties/" class="glass-card metallic-border rounded-xl p-4 card-hover carbon-panel group">
          <div class="font-bold text-white text-sm group-hover:text-volt-400 transition-colors">Warranty guide</div>
          <div class="text-[10px] text-silver-500 mt-1">How to read what's left on {{ copy.ctx.age | aan }} {{ copy.ctx.age }}-year-old {{ entry.name }}</div>
        </a>
        <a href="/guides/recalls-resale-value/" class="glass-card metallic-border rounded-xl p-4 card-hover carbon-panel group">
          <div class="font-bold text-white text-sm group-hover:text-volt-400 transition-colors">Recalls and resale value</div>
          <div class="text-[10px] text-silver-500 mt-1">What an open campaign does to a sale</div>
        </a>
        <a href="/blog/how-to-negotiate-used-car-price/" class="glass-card metallic-border rounded-xl p-4 card-hover carbon-panel group">
          <div class="font-bold text-white text-sm group-hover:text-volt-400 transition-colors">Compare sale offers</div>
          <div class="text-[10px] text-silver-500 mt-1">Trade-in credit and an outright sale are different deals</div>
        </a>
      </div>
    </div>

    {# Ownership CTAs #}
    <div class="mb-10">
      <h2 class="text-xl font-black text-white mb-6">{{ entry.year }} {{ entry.makeName }} {{ entry.name }} Ownership Resources</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        <a href="/go/insurance/" rel="nofollow sponsored noopener" class="glass-card metallic-border rounded-xl p-5 carbon-panel card-hover group">
          <h3 class="font-bold text-white text-sm mb-2 group-hover:text-volt-400 transition-colors">Insurance</h3>
          <p class="text-xs text-silver-400 leading-relaxed" data-vehicle-copy>{{ copy.blurbs.insurance }}</p>
        </a>
        <a href="/go/warranty/" rel="nofollow sponsored noopener" class="glass-card metallic-border rounded-xl p-5 carbon-panel card-hover group">
          <h3 class="font-bold text-white text-sm mb-2 group-hover:text-volt-400 transition-colors">Warranty</h3>
          <p class="text-xs text-silver-400 leading-relaxed" data-vehicle-copy>{{ copy.blurbs.warranty }}</p>
        </a>
        <a href="/guides/financing/" class="glass-card metallic-border rounded-xl p-5 carbon-panel card-hover group">
          <h3 class="font-bold text-white text-sm mb-2 group-hover:text-volt-400 transition-colors">Financing</h3>
          <p class="text-xs text-silver-400 leading-relaxed" data-vehicle-copy>{{ copy.blurbs.financing }}</p>
        </a>
        <a href="/blog/how-to-negotiate-used-car-price/" class="glass-card metallic-border rounded-xl p-5 carbon-panel card-hover group">
          <h3 class="font-bold text-white text-sm mb-2 group-hover:text-volt-400 transition-colors">Selling</h3>
          <p class="text-xs text-silver-400 leading-relaxed" data-vehicle-copy>{{ copy.blurbs.selling }}</p>
        </a>
      </div>
    </div>

    {# FAQ Section #}
    <div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel mb-10">
      <div class="steel-header px-6 py-4">
        <h2 class="font-bold text-white text-lg">{{ entry.year }} {{ entry.makeName }} {{ entry.name }} FAQ</h2>
      </div>
      <div class="px-6 py-5 space-y-4">
        {% for faq in copy.faqs %}
        <details class="group">
          <summary class="cursor-pointer text-sm font-bold text-silver-300 group-open:text-volt-400 transition-colors py-2">{{ faq.q }}</summary>
          <p class="text-sm text-silver-400 leading-relaxed pb-3 pl-4" data-vehicle-copy>{{ faq.a }}</p>
        </details>
        {% endfor %}
        <p class="text-xs text-silver-500">The inspection checklist, the recall lookup, and the warranty guide are linked above so this page does not repeat them as if they were unique to this year.</p>
      </div>
    </div>

    {# State-Specific Guides #}
    <div class="mb-10">
      <h2 class="text-xl font-black text-white mb-6">{{ entry.year }} {{ entry.makeName }} {{ entry.name }} by State</h2>
      <p class="text-sm text-silver-400 mb-4">Insurance requirements, lemon law protections, and registration rules vary by state. View state-specific information for the {{ entry.year }} {{ entry.makeName }} {{ entry.name }}:</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-2">
        {% for st in states %}
        <a href="/makes/{{ entry.makeSlug }}/{{ entry.slug }}/{{ entry.year }}/in/{{ st.slug }}/" class="glass-card metallic-border rounded-lg p-2 card-hover carbon-panel group text-center">
          <div class="font-bold text-white group-hover:text-volt-400 transition-colors text-xs">{{ st.abbreviation }}</div>
          <div class="text-[10px] text-silver-500 mt-0.5">{{ st.name }}</div>
        </a>
        {% endfor %}
      </div>
    </div>

    {# Browse Other Years #}
    <div class="mb-10">
      <h2 class="text-xl font-black text-white mb-6">Other {{ entry.makeName }} {{ entry.name }} Model Years</h2>
      <div class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-8 gap-2">
        {% for yr in entry.makeSlug | lookupYears(entry.slug, entry.year) %}
          <a href="/makes/{{ entry.makeSlug }}/{{ entry.slug }}/{{ yr }}/" class="glass-card metallic-border rounded-lg p-2 card-hover carbon-panel group text-center">
            <div class="font-bold text-white group-hover:text-volt-400 transition-colors text-sm">{{ yr }}</div>
          </a>
        {% endfor %}
      </div>
    </div>

    {# Back to Model #}
    <div class="text-center">
      <a href="/makes/{{ entry.makeSlug }}/{{ entry.slug }}/" class="inline-flex items-center gap-2 btn-ghost px-6 py-3 rounded-xl text-silver-300 hover:text-white text-sm font-medium">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
        All {{ entry.makeName }} {{ entry.name }} Years
      </a>
    </div>
  </div>
</section>

<script>
(function(){
  var vinInput=document.getElementById('vinInput'),runBtn=document.getElementById('runBtn'),loading=document.getElementById('loading'),errorBox=document.getElementById('errorBox'),errorText=document.getElementById('errorText'),vehicleCard=document.getElementById('vehicleCard'),recallCard=document.getElementById('recallCard');
  if(!vinInput||!runBtn)return;
  function setLoading(on){loading.classList.toggle('hidden',!on);}
  function setError(msg){if(!msg){errorBox.classList.add('hidden');return;}errorText.textContent=msg;errorBox.classList.remove('hidden');}
  function fetchJSON(url,ms){var c=new AbortController();var t=setTimeout(function(){c.abort();},ms||12000);return fetch(url,{signal:c.signal}).then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.json();}).finally(function(){clearTimeout(t);});}
  async function run(){
    setError();vehicleCard.classList.add('hidden');recallCard.classList.add('hidden');
    var vin=(vinInput.value||'').trim().toUpperCase();
    var vc=window.caVinCheck?caVinCheck(vin):{vin:vin,error:vin.length!==17?'Please enter a valid 17-character VIN.':''};if(window.caVinShowWarning)caVinShowWarning(vc.warning);if(vc.error){setError(vc.error);return;}vin=vc.vin;
    setLoading(true);
    try{
      var d=await fetchJSON('https://vpic.nhtsa.dot.gov/api/vehicles/DecodeVinValuesExtended/'+vin+'?format=json');
      var dec=(d.Results&&d.Results[0])||{};
      var f=[['Year',dec.ModelYear],['Make',dec.Make],['Model',dec.Model],['Trim',dec.Trim],['Engine',((dec.DisplacementL||'')+'L '+(dec.FuelTypePrimary||'')).trim()],['Body',dec.BodyClass],['Drive',dec.DriveType]].filter(function(x){return x[1]&&String(x[1]).trim()!=='';});
      vehicleCard.innerHTML='<div class="glass-card metallic-border rounded-2xl overflow-hidden glow-cyan-sm animate-in carbon-panel"><div class="steel-header px-6 py-4"><h3 class="text-lg font-bold text-white">Vehicle Specs</h3></div><div class="px-6 py-5"><div class="grid sm:grid-cols-2 md:grid-cols-3 gap-3">'+f.map(function(x){return '<div class="p-3 rounded-xl bg-white/[0.02] border border-white/[0.05]"><div class="text-[10px] font-semibold text-silver-500 uppercase">'+x[0]+'</div><div class="font-semibold text-white mt-0.5">'+x[1]+'</div></div>';}).join('')+'</div></div></div>';
      vehicleCard.classList.remove('hidden');
      try{var mk=encodeURIComponent(dec.Make||''),md=encodeURIComponent(dec.Model||''),yr=encodeURIComponent(dec.ModelYear||'');if(mk&&md&&yr){var r=await fetchJSON('https://api.nhtsa.gov/recalls/recallsByVehicle?make='+mk+'&model='+md+'&modelYear='+yr);var cnt=(r&&r.results)?r.results.length:0;recallCard.innerHTML='<div class="glass-card metallic-border rounded-2xl p-6 animate-in carbon-panel"><div class="flex items-center gap-2 '+(cnt>0?'text-amber-300':'text-emerald-400')+' text-sm font-bold">'+(cnt>0?cnt+' recall(s) found. <a href="/recall-checker/" class="underline ml-1">View details</a>':'No open recalls found.')+'</div></div>';recallCard.classList.remove('hidden');}}catch(e){}
    }catch(e){setError('Service unavailable. Try again shortly.');}finally{setLoading(false);}
  }
  runBtn.addEventListener('click',run);vinInput.addEventListener('keydown',function(e){if(e.key==='Enter')run();});
})();
</script>
