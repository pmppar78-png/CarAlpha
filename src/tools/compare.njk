      </div>
      <div class="glass-card metallic-border rounded-2xl p-6 carbon-panel">
        <div class="steel-header -mx-6 -mt-6 px-6 py-3 mb-5 rounded-t-2xl">
          <h2 class="font-bold text-white text-sm">Vehicle 2</h2>
        </div>
        <label class="block text-xs font-bold text-silver-400 mb-2 tracking-wide uppercase">VIN</label>
        <input id="vin2" maxlength="17" placeholder="Enter second VIN" class="w-full px-4 py-3 rounded-xl input-premium text-white placeholder-silver-500 text-sm font-mono tracking-wider" />
      </div>
    </div>

    <div class="text-center mt-8">
      <button id="compareBtn" class="px-10 py-4 rounded-xl btn-primary text-white font-bold text-base tracking-wide">Compare Vehicles</button>
    </div>

