{# ── Next-steps panel. The chat assistant stays offline until ANTHROPIC_API_KEY is set. #}

<div id="aiOverlay" class="ai-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="nextStepsTitle">
  <div class="ai-modal w-full max-w-2xl rounded-2xl shadow-premium flex flex-col carbon-panel" style="max-height: 85vh; border: 1px solid rgba(6,182,212,0.15);">

    <div class="flex items-center justify-between px-6 py-4" style="background: linear-gradient(135deg, rgba(6,182,212,0.08) 0%, rgba(13,17,23,0.9) 100%); border-bottom: 1px solid rgba(6,182,212,0.1);">
      <div class="flex items-center gap-3">
        <div class="relative h-10 w-10 rounded-xl bg-gradient-to-br from-volt-500 to-volt-700 grid place-items-center text-white shadow-lg shadow-volt-500/30">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
          <div class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-amber-400 border-2 border-carbon-900"></div>
        </div>
        <div>
          <div id="nextStepsTitle" class="font-bold text-white text-sm tracking-tight">Next steps</div>
          <div class="text-[11px] text-amber-300/80 font-medium">Assistant offline &middot; These tools still work</div>
        </div>
      </div>
      <button id="closeAI" aria-label="Close next steps" class="p-2 rounded-lg hover:bg-white/[0.05] text-silver-400 hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="scrollbox flex-1 px-6 py-5 text-sm overflow-y-auto">
      <p class="text-silver-300 leading-relaxed">The chat assistant is turned off. This site does not have an API key configured, so it cannot answer a typed question and this panel does not send one. Use the pages below. The VIN decoder and the recall checker query NHTSA directly. The lemon-law pages cite the statute that was checked. Insurance and warranty guides name the source for any dollar figure.</p>
      <div class="mt-5 grid sm:grid-cols-2 gap-3">
        <a href="/vin-decoder/" class="flex items-start gap-3 p-3 rounded-xl bg-white/[0.02] border border-white/[0.05] hover:border-volt-500/30 hover:bg-volt-600/[0.04] transition-all group">
          <div>
            <div class="font-semibold text-white text-sm group-hover:text-volt-400 transition-colors">VIN decoder</div>
            <div class="text-xs text-silver-500 mt-0.5">Make, model, year, engine, and plant from NHTSA vPIC</div>
          </div>
        </a>
        <a href="/recall-checker/" class="flex items-start gap-3 p-3 rounded-xl bg-white/[0.02] border border-white/[0.05] hover:border-volt-500/30 hover:bg-volt-600/[0.04] transition-all group">
          <div>
            <div class="font-semibold text-white text-sm group-hover:text-volt-400 transition-colors">Recall checker</div>
            <div class="text-xs text-silver-500 mt-0.5">Open campaigns, consequences, and the free remedy</div>
          </div>
        </a>
        <a href="/free-vin-check/" class="flex items-start gap-3 p-3 rounded-xl bg-white/[0.02] border border-white/[0.05] hover:border-volt-500/30 hover:bg-volt-600/[0.04] transition-all group">
          <div>
            <div class="font-semibold text-white text-sm group-hover:text-volt-400 transition-colors">Free VIN check</div>
            <div class="text-xs text-silver-500 mt-0.5">Specs and open recalls. A full history report is a paid product</div>
          </div>
        </a>
        <a href="/guides/lemon-law/" class="flex items-start gap-3 p-3 rounded-xl bg-white/[0.02] border border-white/[0.05] hover:border-volt-500/30 hover:bg-volt-600/[0.04] transition-all group">
          <div>
            <div class="font-semibold text-white text-sm group-hover:text-volt-400 transition-colors">Lemon law guide</div>
            <div class="text-xs text-silver-500 mt-0.5">Repair counts and mileage caps, with the state statute linked</div>
          </div>
        </a>
        <a href="/guides/insurance/" class="flex items-start gap-3 p-3 rounded-xl bg-white/[0.02] border border-white/[0.05] hover:border-volt-500/30 hover:bg-volt-600/[0.04] transition-all group">
          <div>
            <div class="font-semibold text-white text-sm group-hover:text-volt-400 transition-colors">Insurance guides</div>
            <div class="text-xs text-silver-500 mt-0.5">What to compare, and which ranking a carrier is actually in</div>
          </div>
        </a>
        <a href="/guides/warranties/" class="flex items-start gap-3 p-3 rounded-xl bg-white/[0.02] border border-white/[0.05] hover:border-volt-500/30 hover:bg-volt-600/[0.04] transition-all group">
          <div>
            <div class="font-semibold text-white text-sm group-hover:text-volt-400 transition-colors">Warranty guides</div>
            <div class="text-xs text-silver-500 mt-0.5">Factory coverage versus a vehicle service contract</div>
          </div>
        </a>
      </div>
    </div>

    <div class="px-6 py-4" style="border-top: 1px solid rgba(6,182,212,0.08);">
      <div class="flex items-center justify-between gap-4">
        <span class="text-[10px] text-silver-500/70">Chat stays off until an API key is configured for this site.</span>
        <span class="text-[10px] text-silver-500/40 shrink-0">We never sell your data</span>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var aiOverlay = document.getElementById('aiOverlay');
  var openAI = document.getElementById('openAI');
  var closeAI = document.getElementById('closeAI');

  if (!aiOverlay || !openAI) return;

  function openPanel() {
    aiOverlay.classList.add('active');
    if (closeAI) closeAI.focus();
  }

  function closePanel() {
    aiOverlay.classList.remove('active');
    if (openAI) openAI.focus();
  }

  openAI.addEventListener('click', openPanel);

  if (closeAI) closeAI.addEventListener('click', closePanel);

  aiOverlay.addEventListener('click', function(e) {
    if (e.target === aiOverlay) closePanel();
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && aiOverlay.classList.contains('active')) closePanel();
  });

  document.querySelectorAll('[data-open-next-steps]').forEach(function(btn) {
    btn.addEventListener('click', openPanel);
  });

  var modalEl = aiOverlay.querySelector('.ai-modal');
  if (modalEl) {
    aiOverlay.addEventListener('keydown', function(e) {
      if (e.key !== 'Tab' || !aiOverlay.classList.contains('active')) return;
      var focusable = modalEl.querySelectorAll('button, a[href], [tabindex]:not([tabindex="-1"])');
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) { e.preventDefault(); last.focus(); }
      } else if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }
})();
</script>
