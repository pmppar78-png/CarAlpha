{# ── Email Capture — Recall Alerts + VIN Checklist ── #}
<div class="glass-card metallic-border rounded-2xl overflow-hidden carbon-panel" id="email-capture">
  <div class="p-6 md:p-8">
    <div class="flex items-start gap-3 mb-4">
      <div class="feature-icon w-11 h-11 rounded-xl grid place-items-center shrink-0">
        <svg class="w-5 h-5 text-volt-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/></svg>
      </div>
      <div>
        <h3 class="text-lg font-bold text-white">Free Recall Alerts</h3>
        <p class="text-sm text-silver-400 mt-1 leading-relaxed">Get notified when new recalls are issued for your vehicle. Plus, receive our free VIN Buyer's Checklist PDF.</p>
      </div>
    </div>

    <form name="recall-alerts" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-3">
      <p class="hidden"><label>Ignore: <input name="bot-field" /></label></p>
      <input type="email" name="email" required placeholder="your@email.com"
        class="w-full px-4 py-3 rounded-xl input-premium text-white placeholder-silver-500 text-sm" />
      <div class="grid grid-cols-2 gap-3">
        <input type="text" name="make" placeholder="Make (e.g., Toyota)"
          class="px-4 py-3 rounded-xl input-premium text-white placeholder-silver-500 text-sm" />
        <input type="text" name="model" placeholder="Model (e.g., Camry)"
          class="px-4 py-3 rounded-xl input-premium text-white placeholder-silver-500 text-sm" />
      </div>
      <button type="submit" class="w-full px-6 py-3 rounded-xl btn-primary text-white font-bold text-sm tracking-wide flex items-center justify-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
        Get Free Alerts + Checklist
      </button>
      <p class="text-[10px] text-silver-500/50 text-center">No spam. Unsubscribe anytime. We never share your email.</p>
    </form>
  </div>
</div>
